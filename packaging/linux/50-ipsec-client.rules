// Lets the IPsec VPN client service (user ipsec-client) set and revert the
// per-link DNS of its tunnel interface through systemd-resolved. resolved
// already accepts callers holding CAP_NET_ADMIN on most systemd versions;
// this rule makes it explicit and version-independent (002 research R7).
// It grants nothing else.
polkit.addRule(function (action, subject) {
    if (subject.user !== "ipsec-client") {
        return polkit.Result.NOT_HANDLED;
    }
    switch (action.id) {
        case "org.freedesktop.resolve1.set-dns-servers":
        case "org.freedesktop.resolve1.set-domains":
        case "org.freedesktop.resolve1.set-default-route":
        case "org.freedesktop.resolve1.revert":
            return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
